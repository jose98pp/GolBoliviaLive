# ── Autenticación del panel (/login) ──
# Secreto para firmar los tokens de sesión. Mínimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SERVER_SECRET=""

# PIN de cada operador (mínimo 6 caracteres). Si un PIN no está configurado, ese usuario no puede entrar.
ADMIN_PIN=""
TRANSMISOR_PIN=""
MODERADOR_PIN=""
EDITOR_PIN=""

# ── Escritura en Firestore ──
# Usuario de Firebase Authentication (Email/Contraseña) con el que el backend escribe en Firestore.
# Su UID debe existir como documento en la colección /admins (ver README).
FIREBASE_SERVER_EMAIL=""
FIREBASE_SERVER_PASSWORD=""
