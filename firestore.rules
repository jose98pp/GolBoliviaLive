rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura pública para visitantes en todas las colecciones oficiales
    match /{document=**} {
      allow read: if true;
    }

    // Colecciones de configuración y ajustes oficiales (incluyendo QR y señal de streaming)
    match /config/{docId} {
      allow read, write: if true;
    }

    // Marcador y estado en tiempo real
    match /match/{docId} {
      allow read, write: if true;
    }

    // Partidos y eventos en vivo
    match /liveEvents/{eventId} {
      allow read, write: if true;
    }

    // Equipos y clubes
    match /clubs/{clubId} {
      allow read, write: if true;
    }

    // Eventos e incidencias del partido
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Chat interactivo
    match /chat/{msgId} {
      allow create: if request.resource.data.text is string 
                    && request.resource.data.text.size() > 0 
                    && request.resource.data.text.size() <= 300;
      allow update, delete: if true;
    }

    // Encuestas interactivas
    match /polls/{pollId} {
      allow read, write: if true;
    }

    // Registro de auditoría
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}

