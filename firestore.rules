rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el usuario autenticado del backend registrado en admins puede escribir.
    function isBackend() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isBackend();
    }

    match /match/{docId} {
      allow read: if true;
      allow write: if isBackend();
    }

    match /liveEvents/{eventId} {
      allow read: if true;
      allow write: if isBackend();
    }

    match /matchAnalytics/{matchId}/{document=**} {
      allow read, write: if isBackend();
    }

    match /iptvCustomChannels/{channelId} {
      allow read: if true;
      allow write: if isBackend();
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isBackend();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isBackend();
    }

    match /polls/{pollId} {
      allow read: if true;
      allow write: if isBackend();
    }

    match /confirmations/{logId} {
      allow read: if true;
      allow write: if isBackend();
    }

    // Auditoría: solo el backend puede leerla (contiene operadores y acciones internas).
    match /audit_logs/{logId} {
      allow read: if isBackend();
      allow create: if isBackend();
      allow update, delete: if false;
    }

    // Chat: los hinchas pueden crear mensajes validados; solo el backend modera (edita/borra).
    match /chat/{msgId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['id', 'sender', 'clubId', 'text', 'timestamp', 'isVip', 'superChatAmount', 'createdAt'])
                    && request.resource.data.id == msgId
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.sender is string
                    && request.resource.data.sender.size() > 0
                    && request.resource.data.sender.size() <= 40
                    && request.resource.data.id.size() <= 80
                    && (!('isVip' in request.resource.data) || request.resource.data.isVip is bool)
                    && (!('superChatAmount' in request.resource.data)
                        || (request.resource.data.superChatAmount is number
                            && request.resource.data.superChatAmount >= 0
                            && request.resource.data.superChatAmount <= 1000));
      allow update, delete: if isBackend();
    }
  }
}
